# ProdTrack Production Environment
# Copy to .env and fill actual values before deploy.

# PostgreSQL
POSTGRES_DB=prodtrack
POSTGRES_USER=prodtrack
POSTGRES_PASSWORD=change_me_in_production

# Application database URL (uses internal Docker network hostname 'postgres')
DATABASE_URL=postgresql://prodtrack:change_me_in_production@postgres:5432/prodtrack?schema=public

# App version (injected at build time)
VERSION=v2.9.3

# Timezone (affects shift window calculations, Р-07)
TZ=Europe/Moscow

# Node environment (affects secure cookies)
NODE_ENV=production

# Пароль администратора при ПЕРВОМ создании (сид). Если не задан — сид сгенерирует случайный
# и напечатает его в логе один раз; при первом входе система потребует смену пароля.
# После создания администратора переменная ни на что не влияет: существующий пароль не сбрасывается.
# ADMIN_INITIAL_PASSWORD=

# Тестовые учётные записи сида НЕ СОЗДАЮТСЯ, пока не задано SEED_TEST_USERS=true.
# На проде эту переменную НЕ добавляйте: пароли тестовых логинов лежат в публичном репозитории.
# SEED_TEST_USERS=false
