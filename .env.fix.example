# Фикс-стенд ProdTrack — переменные окружения.
# Создаётся скриптом (значения генерируются заново):
#   bash scripts/make-dev-env.sh --fix
#
# .env.fix в git не попадает (см. .gitignore). Пароль и секрет — свои,
# НЕ продовые и НЕ девовые: базы стендов не должны пересекаться.

# PostgreSQL (внутренняя сеть docker-проекта prodtrack-fix)
POSTGRES_DB=prodtrack
POSTGRES_USER=prodtrack
POSTGRES_PASSWORD=change_me_in_fix

# Строка подключения: хост `postgres` — имя сервиса внутри compose-сети
DATABASE_URL=postgresql://prodtrack:change_me_in_fix@postgres:5432/prodtrack?schema=public

# Секрет сессий: сгенерировать свой, например openssl rand -base64 32
SECRET_KEY=change_me_secret

# Версия в футере: суффикс -fix — на скриншоте сразу видно, какой это стенд
VERSION=v2.3.0-fix

# Часовой пояс и режим Node
TZ=Europe/Moscow
NODE_ENV=production
