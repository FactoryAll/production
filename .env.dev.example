# Дев-стенд ProdTrack — переменные окружения.
# Скопировать в .env.dev на сервере и заменить значения-заглушки:
#   cp .env.dev.example .env.dev && chmod 600 .env.dev
#
# .env.dev в git не попадает (см. .gitignore). Пароль и секрет — свои,
# НЕ продовые: дев-база и дев-сессии не должны совпадать с рабочими.

# PostgreSQL (внутренняя сеть docker-проекта prodtrack-dev)
POSTGRES_DB=prodtrack
POSTGRES_USER=prodtrack
POSTGRES_PASSWORD=change_me_in_dev

# Строка подключения: хост `postgres` — имя сервиса внутри compose-сети
DATABASE_URL=postgresql://prodtrack:change_me_in_dev@postgres:5432/prodtrack?schema=public

# Тестовые учётные записи сида (test_multi_role, test_first_login, test_opr_shift, test_s1c).
# Только для стендов: на проде флага нет, иначе свежая база поднимается с логинами,
# пароли которых лежат в публичном репозитории.
SEED_TEST_USERS=true

# Версия в футере: на деве с суффиксом -dev, чтобы её нельзя было спутать с продом
VERSION=v2.9.2-dev

# Часовой пояс и режим Node
TZ=Europe/Moscow
NODE_ENV=production
