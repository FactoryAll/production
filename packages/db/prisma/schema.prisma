generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// === M01: Reference data ===

enum ProductCategory {
  MASS
  GP
}

enum FactCategory {
  MASS
  GP
  PF
}

enum WarehouseType {
  PRODUCTION
  FINISHED_GOODS
}

model WorkCenter {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  producesMass Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lines ProductionOrderLine[]
  summaries ShiftSummary[]

  @@map("work_centers")
}

model Employee {
  id         String   @id @default(uuid())
  tabNumber  String   @unique
  fullName   String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user              User?                   @relation("EmployeeUser")
  operatedLines     ProductionOrderLine[] @relation("OperatorLines")
  workerAssignments ProductionOrderLineWorkers[] @relation("EmployeeWorkers")

  @@map("employees")
}

model Product {
  id          String          @id @default(uuid())
  code        String          @unique
  name        String
  category    ProductCategory
  unit        String
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  orderLines    ProductionOrderLine[]
  facts         ProductionFact[]
  consumptions  ProductionFactConsumption[]
  movements     StockMovement[]
  balances      StockBalance[]
  summaries     ShiftSummary[]
  transferLines TransferLine[]

  @@map("products")
}

model DefectReason {
  id     String  @id @default(uuid())
  code   String  @unique
  name   String
  active Boolean @default(true)

  facts ProductionFact[]

  @@map("defect_reasons")
}

model SubstitutionReason {
  id     String  @id @default(uuid())
  code   String  @unique
  name   String
  active Boolean @default(true)

  @@map("substitution_reasons")
}

model Shift {
  id        String   @id @default(uuid())
  number    Int
  date      DateTime @db.Date
  start     String
  end       String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    ProductionOrder[]
  summaries ShiftSummary[]

  @@unique([number, date])
  @@map("shifts")
}

model Warehouse {
  id          String        @id @default(uuid())
  name        String
  description String?
  type        WarehouseType
  active      Boolean       @default(true)

  movements StockMovement[]
  balances  StockBalance[]

  @@map("warehouses")
}

// === M02: Users, roles, access ===

enum RoleCode {
  NP
  OPR
  KSGP
  USGP
  S1C
  ADM
}

model Role {
  id          String       @id @default(uuid())
  code        RoleCode     @unique
  name        String
  permissions Permission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id     String @id @default(uuid())
  code   String @unique
  action String
  roles  Role[]

  @@map("permissions")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model User {
  id                 String   @id @default(uuid())
  login              String   @unique
  passwordHash       String
  mustChangePassword Boolean  @default(true)
  active             Boolean  @default(true)
  employeeId         String?  @unique
  employee           Employee? @relation("EmployeeUser", fields: [employeeId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  roles         UserRole[]
  sessions      Session[]
  createdOrders   ProductionOrder[] @relation("CreatedOrders")
  confirmedOrders ProductionOrder[] @relation("ConfirmedOrders")
  cancelledOrders ProductionOrder[] @relation("CancelledOrders")
  createdTransfers GoodsTransfer[]
  auditRecords    AuditRecord[]
  notifications   Notification[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("sessions")
}

// === M03: Production orders ===

enum ProductionOrderStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProductionOrderLineStatus {
  ASSIGNED
  ACCEPTED
  REPORTED
}

model ProductionOrder {
  id                String                @id @default(uuid())
  shiftId           String
  shift             Shift                 @relation(fields: [shiftId], references: [id])
  status            ProductionOrderStatus @default(DRAFT)
  createdById       String
  createdBy         User                  @relation(fields: [createdById], references: [id], name: "CreatedOrders")
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  completedAt         DateTime?
  confirmedAt         DateTime?
  confirmedByUserId   String?
  confirmedBy         User?                 @relation(fields: [confirmedByUserId], references: [id], name: "ConfirmedOrders")
  cancelledAt         DateTime?
  cancelledByUserId   String?
  cancelledBy         User?                 @relation(fields: [cancelledByUserId], references: [id], name: "CancelledOrders")
  cancellationReason  String?

  lines ProductionOrderLine[]

  @@map("production_orders")
}

model ProductionOrderLine {
  id                   String                  @id @default(uuid())
  orderId              String
  order                ProductionOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  workCenterId         String
  workCenter           WorkCenter              @relation(fields: [workCenterId], references: [id])
  productId            String
  product              Product                 @relation(fields: [productId], references: [id])
  plannedQuantity      Decimal                 @db.Decimal(18, 4)
  operatorId           String?
  operator             Employee?               @relation("OperatorLines", fields: [operatorId], references: [id])
  status               ProductionOrderLineStatus @default(ASSIGNED)
  comment              String?
  substitutionReasonId String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  workerAssignments ProductionOrderLineWorkers[] @relation("LineWorkers")
  facts   ProductionFact[]

  @@map("production_order_lines")
}

model ProductionOrderLineWorkers {
  lineId     String
  employeeId String
  line       ProductionOrderLine @relation("LineWorkers", fields: [lineId], references: [id], onDelete: Cascade)
  employee   Employee            @relation("EmployeeWorkers", fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([lineId, employeeId])
  @@map("production_order_line_workers")
}

// === M04: Shift execution / facts ===

model ProductionFact {
  id                       String           @id @default(uuid())
  lineId                   String
  line                     ProductionOrderLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  productId                String
  product                  Product          @relation(fields: [productId], references: [id])
  factCategory             FactCategory
  quantity                 Decimal          @db.Decimal(18, 4)
  defectQuantity           Decimal          @default(0) @db.Decimal(18, 4)
  defectReasonId           String?
  defectReason             DefectReason?    @relation(fields: [defectReasonId], references: [id])
  stopsCount               Int              @default(0)
  stopsDurationMinutes     Int              @default(0)
  comment                  String?
  recordedAt               DateTime
  reportedAt               DateTime?
  reportedByUserId         String?
  createdById              String
  postCompletionCorrection Boolean          @default(false)
  correctionReason         String?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  consumptions ProductionFactConsumption[]

  @@unique([lineId])
  @@map("production_facts")
}

model ProductionFactConsumption {
  id        String         @id @default(uuid())
  factId    String
  fact      ProductionFact @relation(fields: [factId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id])
  quantity  Decimal        @db.Decimal(18, 4)

  @@map("production_fact_consumptions")
}

// === M05: Stock ===

enum StockMovementType {
  RECEIPT
  WRITE_OFF
  CONSUMPTION
  RETURN
}

model StockMovement {
  id           String          @id @default(uuid())
  warehouseId  String
  warehouse    Warehouse       @relation(fields: [warehouseId], references: [id])
  productId    String
  product      Product         @relation(fields: [productId], references: [id])
  type         StockMovementType
  quantity     Decimal         @db.Decimal(18, 4)
  documentType String?
  documentId   String?
  createdAt    DateTime        @default(now())

  @@map("stock_movements")
}

model StockBalance {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  quantity    Decimal   @db.Decimal(18, 4)
  updatedAt   DateTime  @updatedAt

  @@unique([warehouseId, productId])
  @@map("stock_balances")
}

// === M06: Shift summary ===

model ShiftSummary {
  id                   String       @id @default(uuid())
  shiftId              String
  shift                Shift        @relation(fields: [shiftId], references: [id])
  workCenterId         String
  workCenter           WorkCenter   @relation(fields: [workCenterId], references: [id])
  productId            String
  product              Product      @relation(fields: [productId], references: [id])
  factCategory         FactCategory
  producedQuantity     Decimal      @db.Decimal(18, 4)
  consumedQuantity     Decimal      @default(0) @db.Decimal(18, 4)
  defectQuantity       Decimal      @default(0) @db.Decimal(18, 4)
  stopsDurationMinutes Int          @default(0)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@map("shift_summaries")
}

// === M07/M08: Transfer and receiving ===

enum TransferStatus {
  DRAFT
  SUBMITTED
  RECEIVED
  DISCREPANCY
  RECONCILED
  CANCELLED
}

model GoodsTransfer {
  id          String         @id @default(uuid())
  status      TransferStatus @default(DRAFT)
  createdById String
  createdBy   User           @relation(fields: [createdById], references: [id])
  sentAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  lines TransferLine[]

  @@map("goods_transfers")
}

model TransferLine {
  id              String        @id @default(uuid())
  transferId      String
  transfer        GoodsTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  plannedQuantity Decimal       @db.Decimal(18, 4)
  actualQuantity  Decimal?      @db.Decimal(18, 4)

  discrepancies Discrepancy[]

  @@map("transfer_lines")
}

model Discrepancy {
  id               String       @id @default(uuid())
  transferLineId   String
  transferLine     TransferLine @relation(fields: [transferLineId], references: [id], onDelete: Cascade)
  plannedQuantity  Decimal      @db.Decimal(18, 4)
  actualQuantity   Decimal      @db.Decimal(18, 4)
  resolvedQuantity Decimal?     @db.Decimal(18, 4)
  resolvedById     String?
  resolvedAt       DateTime?
  createdAt        DateTime     @default(now())

  @@map("discrepancies")
}

// === M09: Notifications ===

enum EventCode {
  EV_01
  EV_02
  EV_03
  EV_04
  EV_05
  EV_06
  EV_07
  EV_08
  EV_09
  EV_10
}

model Notification {
  id          String    @id @default(uuid())
  eventCode   EventCode
  recipientId String
  recipient   User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  title       String
  body        String?
  deepLink    String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@map("notifications")
}

// === M10: Stage timing ===

enum DocumentType {
  PRODUCTION_ORDER
  GOODS_TRANSFER
}

enum EntityType {
  DOCUMENT
  LINE
}

model StageTiming {
  id             String       @id @default(uuid())
  documentType   DocumentType
  documentId     String
  entityType     EntityType
  entityId       String
  fromStatus     String
  toStatus       String
  transitionedAt DateTime
  initiatorRole  String?
  initiatorId    String?

  @@map("stage_timings")
}

// === M12: 1C tasks ===

enum TaskForOneCType {
  PRODUCTION
  TRANSFER
}

enum TaskForOneCStatus {
  PENDING
  PROCESSED
  CANCELLED
}

model TaskForOneC {
  id            String            @id @default(uuid())
  type          TaskForOneCType
  sourceId      String
  sourceType    String
  data          Json
  status        TaskForOneCStatus @default(PENDING)
  processedAt   DateTime?
  processedById String?
  lastChangedAt DateTime          @updatedAt
  createdAt     DateTime          @default(now())

  @@map("tasks_for_one_c")
}

// === M13: Audit ===

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  CANCEL
}

model AuditRecord {
  id         String      @id @default(uuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  role       String?
  action     AuditAction
  objectType String
  objectId   String
  field      String?
  oldValue   String?
  newValue   String?
  createdAt  DateTime    @default(now())
  archived   Boolean     @default(false)

  @@map("audit_records")
}